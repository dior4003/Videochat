PORT=3000
NODE_ENV=development

# MAJBURIY (production): kamida 32 belgili tasodifiy kalit. Yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Moderator paneli uchun maxfiy kalit (kamida 16 belgi). Bo'sh bo'lsa moderator kirishi o'chiq.
MOD_PASSKEY=

# Brauzer clientlari uchun ruxsat etilgan originlar (vergul bilan). Production'da majburiy (web uchun).
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
# Reverse proxy ortida bo'lsa: proxylar soni (masalan 1) yoki 'true'
TRUST_PROXY=

# MySQL / MariaDB — production'da alohida, minimal huquqli foydalanuvchi ishlating (root EMAS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pulselink
DB_PASSWORD=
DB_NAME=pulselink
DB_SSL=false
# Baza/jadval yaratish (dev'da standart true, production'da false). Jadvallar migratsiyalar orqali yaratiladi.
DB_AUTO_CREATE=

# Google Sign-In (Web Client ID). Bo'sh bo'lsa Google orqali kirish o'chiq.
GOOGLE_CLIENT_ID=

# WebRTC TURN (faqat tizimga kirganlarga /api/ice orqali beriladi)
TURN_URL=
# Tavsiya: coturn "use-auth-secret" — vaqtinchalik login/parol hosil qilinadi
TURN_SECRET=
# Yoki (kamroq xavfsiz) doimiy login/parol:
TURN_USERNAME=
TURN_CREDENTIAL=
